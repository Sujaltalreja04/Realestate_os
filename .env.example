# Frontend (Vite) — copy to .env. Format: KEY=value (no quotes, no spaces around =)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# AI keys are NOT set here — they live on the Convex deployment (server-side only):
#   npx convex env set GROQ_API_KEY <key>
#   npx convex env set SARVAM_API_KEY <key>
