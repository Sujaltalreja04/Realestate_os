# ── Frontend (Vite) ─────────────────────────────────────────────
# Copy to .env.local for development. Format: KEY=value (no quotes).
# Everything prefixed VITE_ is bundled into the public website, so NEVER put API keys here.
VITE_CONVEX_URL=https://astute-panda-274.convex.cloud
VITE_CONVEX_SITE_URL=https://astute-panda-274.convex.site

# Used by `npx convex dev` to pick the backend deployment.
CONVEX_DEPLOYMENT=dev:astute-panda-274

# ── Backend secrets (set on Convex, not in this file) ───────────
# AI chat (Gemma 4 / Sarvam 105B) and voice (Bulbul) both use one key:
#   npx convex env set SARVAM_API_KEY <your-key> --deployment-name astute-panda-274
