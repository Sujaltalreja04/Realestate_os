# ── Dependencies ──
node_modules/

# ── Build output ──
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ── Environment / secrets (never commit) ──
.env
.env.*
*.local
!.env.example

# ── Deploy platform folders ──
.vercel/
.netlify/
.firebase/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test / coverage / caches ──
coverage/
.nyc_output/
.cache/
.eslintcache

# ── Editor & OS ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# ── Local tool state (machine-specific, never shared) ──
.convex/
.claude/settings.local.json
.claude/*.local.*
*.pem
*.key
tmp/
scratch/
